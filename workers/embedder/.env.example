# Copy to .env and fill in. NEVER commit the real file.
# The service_role key bypasses row-level security — it lives ONLY on the
# machine running this worker, never in the Next.js app or git.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Embedding model. 384 dims must match vector(384) in the pgvector migration.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Profiles embedded per polling pass.
BATCH_SIZE=10

# Seconds between polls in --loop mode.
POLL_INTERVAL_SECONDS=60
